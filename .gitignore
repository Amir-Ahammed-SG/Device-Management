# Track only the approved source layout at the repository root.
/*
!/.gitattributes
!/.github/
!/.gitignore
!/README.md
!/Scripts/

# Generated and device-specific material never belongs in the source repository.
/Scripts/DeviceManagement/output/
/Scripts/DeviceManagement/Backups/
/Scripts/DeviceManagement/Docs/*
!/Scripts/DeviceManagement/Docs/Device Management - Kiosk Thorough Check Guide.md
/Scripts/DeviceManagement/Docs/Validation/
/Scripts/DeviceManagement/Docs/Deployments/
**/node_modules/
**/__pycache__/
**/.aws/
**/.ssh/
**/.codex/
**/.agents/
.env
.env.*
*.pem
*.key
*.pfx
*.p12
*.ppk
*.bak
*.log
*.html
*.pdf
*.png
*.exe
*.msi
*.zip
*.tmp
Thumbs.db
Desktop.ini
.DS_Store
