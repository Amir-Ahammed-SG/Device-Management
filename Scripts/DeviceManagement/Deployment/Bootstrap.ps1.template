# SELISE Device Management in-memory entry. Generated by Build-Release.ps1.
& {
    $ErrorActionPreference = 'Stop'
    if ($PSVersionTable.PSVersion -lt [version]'5.1' -or $PSVersionTable.PSEdition -ne 'Desktop' -or -not [Environment]::Is64BitProcess) {
        throw 'Run this command in 64-bit Windows PowerShell 5.1.'
    }

    $resources = @@RESOURCES@@
    $bundle = @{ Files = @{}; Configurations = @{} }
    foreach ($name in $resources.Keys) {
        $bytes = [Convert]::FromBase64String($resources[$name].Data)
        $hasher = [Security.Cryptography.SHA256]::Create()
        try { $hash = [BitConverter]::ToString($hasher.ComputeHash($bytes)).Replace('-', '') } finally { $hasher.Dispose() }
        if ($hash -ne $resources[$name].SHA256) { throw ('Embedded project resource verification failed: ' + $name) }
        $bundle.Files[$name] = [Text.Encoding]::UTF8.GetString($bytes)
    }
    foreach ($configuration in @('Clients', 'Operations', 'PaymentPackages', 'KioskClients')) {
        $tokens = $null; $errors = $null
        $ast = [Management.Automation.Language.Parser]::ParseInput($bundle.Files['DeviceManagement/Config/' + $configuration + '.psd1'], [ref]$tokens, [ref]$errors)
        if ($errors.Count -or $ast.EndBlock.Statements.Count -ne 1) { throw ('Invalid embedded configuration: ' + $configuration) }
        $bundle.Configurations[$configuration] = $ast.EndBlock.Statements[0].PipelineElements[0].Expression.SafeGetValue()
    }
    $runtimeCode = $bundle.Files['Deployment/MemoryRuntime.ps1']
    . ([scriptblock]::Create($runtimeCode))
    $result = Invoke-DeviceManagementMemoryScript -Code $bundle.Files['DeviceManagement/Start-DeviceManagement.ps1'] -Bundle $bundle -RuntimeCode $runtimeCode
    if ($result.State -ne 'Completed') { throw ('Device Management could not complete: ' + $result.Failure + ' ' + ($result.Errors | Out-String)) }
}
